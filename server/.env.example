# Environment Variables untuk Backend

# Salin file ini menjadi .env dan isi nilainya
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=toko_online

# JWT Secret (boleh string acak apa saja)
JWT_SECRET=your_jwt_secret_key_here

# Xendit
XENDIT_SECRET_KEY=<XENDIT_SECRET_KEY>
XENDIT_WEBHOOK_TOKEN=<XENDIT_WEBHOOK_TOKEN>

# URL frontend (untuk Xendit success/failure redirect)
CLIENT_URL=http://localhost:5173
